# ============================================================
# RemindmeAI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=RemindmeAI
DEBUG=false

# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# Generate FERNET_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-with-fernet-generate-key

# --- PostgreSQL ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://remindme:remindme@localhost:5432/remindmeai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Gmail OAuth 2.0 ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:8000/auth/callback/gmail
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/auth/callback/gmail

# --- AWS SES (email notifications) ---
# IAM user requires ses:SendEmail permission
# Verify sender email in SES console before use (sandbox requires recipient verification too)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
SES_SENDER_EMAIL=noreply@yourdomain.com

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# ============================================================
# Frontend (Vite build-time — add to frontend/.env.local)
# ============================================================
VITE_API_BASE_URL=http://localhost:8000

# ============================================================
# Phase 2 — Intelligence (fill in to enable)
# ============================================================

# --- Firebase Cloud Messaging (push notifications) ---
# 1. Create a Firebase project: https://console.firebase.google.com
# 2. Project Settings → Service Accounts → Generate new private key
# 3. Download the JSON file, then paste its content as a single-line string below
# Leave empty to disable push notifications (email channel still works)
FCM_SERVICE_ACCOUNT_JSON=

# --- ML Classifier (DistilBERT zero-shot) ---
# Set to false to skip Tier 2 ML inference and always use rule-based Tier 1.
# First run will download ~82 MB model to HuggingFace cache (~/.cache/huggingface).
ENABLE_ML_CLASSIFIER=true
ML_CLASSIFIER_MODEL=cross-encoder/nli-distilroberta-base

# --- Redis PKCE TTL ---
# Seconds before an OAuth PKCE state entry expires in Redis.
PKCE_TTL_SECONDS=600

# ============================================================
# Phase 3 — Multi-provider + Resilience
# ============================================================

# --- Outlook OAuth 2.0 (Microsoft Identity Platform) ---
# 1. Register an app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# 2. Add redirect URI: http://localhost:8000/auth/callback/outlook
# 3. API permissions: Mail.Read, User.Read, Calendars.ReadWrite, offline_access
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8000/auth/callback/outlook

# --- Google Calendar ---
# Reuses Gmail OAuth token; ensure calendar.events scope is included in GMAIL_SCOPES.
# Set to false to disable Calendar event creation.
ENABLE_GOOGLE_CALENDAR=true

# --- RabbitMQ (optional — replaces Redis as Celery broker) ---
# Format: amqp://user:password@host:5672/vhost
# Leave blank to keep using Redis broker.
RABBITMQ_URL=
