{
  "title": "RemindmeAI — Application Dashboard",
  "uid": "remindmeai-main",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(rate(http_requests_total[1m]))",
        "legendFormat": "req/s"
      }]
    },
    {
      "id": 2, "type": "stat", "title": "Error Rate",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(rate(http_requests_total{status_code=~'5..'}[1m])) / sum(rate(http_requests_total[1m]))",
        "legendFormat": "error %"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": {
        "steps": [
          { "color": "green", "value": 0 },
          { "color": "yellow", "value": 0.01 },
          { "color": "red", "value": 0.05 }
        ]
      }}}
    },
    {
      "id": 3, "type": "stat", "title": "P95 Latency",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }],
      "fieldConfig": { "defaults": { "unit": "s" }}
    },
    {
      "id": 4, "type": "stat", "title": "Emails Processed (1h)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "increase(remindme_emails_processed_total[1h])",
        "legendFormat": "emails"
      }]
    },
    {
      "id": 5, "type": "stat", "title": "Deadlines Created (1h)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "increase(remindme_deadlines_created_total[1h])",
        "legendFormat": "deadlines"
      }]
    },
    {
      "id": 6, "type": "stat", "title": "Spam Detected (1h)",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "increase(remindme_spam_detected_total[1h])",
        "legendFormat": "spam"
      }]
    },
    {
      "id": 7, "type": "timeseries", "title": "HTTP Request Rate by Status",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status_code=~'2..'}[1m]))", "legendFormat": "2xx" },
        { "expr": "sum(rate(http_requests_total{status_code=~'4..'}[1m]))", "legendFormat": "4xx" },
        { "expr": "sum(rate(http_requests_total{status_code=~'5..'}[1m]))", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "NLP Processing Duration",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(remindme_nlp_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(remindme_nlp_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(remindme_nlp_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }}
    },
    {
      "id": 9, "type": "timeseries", "title": "Active Email Connections",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 6 },
      "targets": [
        { "expr": "remindme_active_email_connections{provider='gmail'}", "legendFormat": "Gmail" },
        { "expr": "remindme_active_email_connections{provider='outlook'}", "legendFormat": "Outlook" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Circuit Breaker Opens",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 6 },
      "targets": [{
        "expr": "increase(remindme_circuit_breaker_open_total[5m])",
        "legendFormat": "{{ circuit_name }}"
      }]
    },
    {
      "id": 11, "type": "timeseries", "title": "Reminders Sent by Channel",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 6 },
      "targets": [{
        "expr": "increase(remindme_reminders_sent_total[5m])",
        "legendFormat": "{{ channel }}"
      }]
    }
  ]
}
